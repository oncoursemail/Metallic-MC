# NEVER commit actual credentials. Generate unique random values per environment.
# Local control-plane development; load these variables in your shell before go run.
METALLIC_ADMIN_USER=admin
METALLIC_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_16_PLUS_CHARACTER_SECRET
METALLIC_AGENT_TOKEN=REPLACE_WITH_UNIQUE_32_PLUS_CHARACTER_SECRET
METALLIC_LISTEN_ADDR=127.0.0.1:8080
METALLIC_COOKIE_SECURE=false

# Node agent (run separately on each Linux compute node)
METALLIC_CONTROL_URL=http://127.0.0.1:8080
METALLIC_NODE_ID=metallic-node-01
METALLIC_AGENT_DISK_PATH=/
METALLIC_SERVICES=proxy@127.0.0.1:25565,lobby@127.0.0.1:25566
# For remote deployment use HTTPS, not plaintext HTTP.
