# NEVER commit actual credentials. Generate unique random values per environment.
# Local control-plane development; load these variables in your shell before go run.
METALLIC_ADMIN_USER=admin
METALLIC_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_16_PLUS_CHARACTER_SECRET
METALLIC_AGENT_TOKEN=REPLACE_WITH_UNIQUE_32_PLUS_CHARACTER_SECRET
# Optional, separately scoped READ-ONLY API access for Star AI. Disabled if omitted.
# Must differ from AGENT_TOKEN and be at least 24 characters.
# METALLIC_STARAI_READ_TOKEN=REPLACE_WITH_A_DIFFERENT_UNIQUE_SECRET
METALLIC_LISTEN_ADDR=127.0.0.1:8080
METALLIC_COOKIE_SECURE=false

# Node agent (run separately on each Linux compute node)
METALLIC_CONTROL_URL=http://127.0.0.1:8080
METALLIC_NODE_ID=metallic-node-01
METALLIC_AGENT_DISK_PATH=/
METALLIC_SERVICES=proxy@127.0.0.1:25565,lobby@127.0.0.1:25566
# For remote deployment use HTTPS, not plaintext HTTP.

# Optional PRIVATE Architect workbench. All new APIs are absent by default.
# Existing monitoring and its read-only agent are unchanged.
METALLIC_ARCHITECT_ENABLED=false
# Exact browser origin when using an HTTPS reverse proxy, without a trailing /.
# METALLIC_ARCHITECT_ORIGIN=https://YOUR_CONTROL_DOMAIN

# Optional identity-only Discord linking. Configure all four together.
# Register this application's exact callback in the Discord developer portal.
# METALLIC_DISCORD_CLIENT_ID=YOUR_OWN_DISCORD_APPLICATION_ID
# METALLIC_DISCORD_CLIENT_SECRET=YOUR_SERVER_SIDE_DISCORD_SECRET
# METALLIC_DISCORD_REDIRECT_URL=http://127.0.0.1:8080/api/v1/architect/discord/callback
# METALLIC_IDENTITY_STORE_PATH=/ABSOLUTE/PRIVATE/PATH/discord-links.json
# HTTPS callbacks require METALLIC_COOKIE_SECURE=true and ARCHITECT_ORIGIN.
# No Microsoft or Discord credentials belong in a community host's config.
