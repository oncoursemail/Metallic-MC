# Geyser 2.12.0, config schema 10. All listeners and advertisements stay local.
config-version: 10
bedrock:
  address: "127.0.0.1"
  port: $bedrock_port
  webrtc-port: $bedrock_port
  clone-remote-port: false
  transport: "nethernet"
  signaling:
    mode: "builtin"
    builtin:
      advertise-addresses: ["127.0.0.1:$bedrock_port"]
java:
  auth-type: "floodgate"
motd:
  primary-motd: "Metallic-MC"
  secondary-motd: "Private pilot"
  passthrough-motd: true
  passthrough-player-counts: true
gameplay:
  server-name: "Metallic-MC"
  force-resource-packs: false
log-player-ip-addresses: false
saved-user-logins: []
debug-mode: false
advanced:
  resource-pack-urls: []
  java:
    use-direct-connection: true
    use-haproxy-protocol: false
  bedrock:
    use-haproxy-protocol: false
    validate-bedrock-login: true
  nxs:
    assisted-joins: false
    connection-checks: false
    stun-discovery: false
