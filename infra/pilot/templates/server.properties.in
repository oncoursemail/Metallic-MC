# Local staging only. Authentication is performed by Velocity with modern forwarding.
server-ip=127.0.0.1
server-port=$port
motd=Metallic-MC - $role private pilot
online-mode=false
enforce-secure-profile=false
enable-rcon=false
enable-query=false
enable-jmx-monitoring=false
management-server-enabled=false
white-list=true
enforce-whitelist=true
max-players=$players
level-name=world
level-seed=827613941
level-type=$level_type
generate-structures=false
max-world-size=512
view-distance=6
simulation-distance=4
sync-chunk-writes=true
max-tick-time=60000
spawn-protection=16
gamemode=$gamemode
force-gamemode=true
difficulty=normal
pvp=false
allow-flight=false
allow-nether=false
accepts-transfers=false
pause-when-empty-seconds=0
resource-pack=
